{
  "name": "@farena/farena-ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Farena React UI components",
  "license": "MIT",
  "homepage": "https://github.com/farena/farena-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farena/farena-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/farena/farena-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/clean-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node -e \"require('fs').copyFileSync('../../README.md', 'README.md')\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@farena/fa-modal-react": "^0.0.0",
    "@farena/fa-wysiwyg-react": "^1.0.0",
    "@monaco-editor/react": "^4.7.0",
    "apexcharts": "^7.8.0",
    "react-apexcharts": "^2.1.1",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^26.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass-embedded": "^1.105.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.0"
  }
}
